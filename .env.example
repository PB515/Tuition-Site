# Copy this file to .env.local and fill the values. NEVER commit .env.local.
# After setting these in Vercel (Project Settings > Environment Variables), redeploy.

# Supabase (Mumbai region) - from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend - from https://resend.com (API Keys). FROM must be a verified domain
# (until then, use the sandbox sender, which only delivers to your own address).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Inspire Academy <onboarding@resend.dev>
FIRM_NOTIFICATION_EMAIL=
